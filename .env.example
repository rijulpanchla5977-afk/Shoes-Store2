# ==============================================================================
# JOD SHOES STORE — Environment Variables Example
# Duplicate this file to .env in backend/ or set these variables in Vercel Project Settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / client)
# ------------------------------------------------------------------------------
# In production on Vercel, leave as /api to use same-domain rewrites.
# In local development, you can set: http://localhost:5001/api
VITE_API_URL=/api

# ------------------------------------------------------------------------------
# 2. BACKEND RUNTIME ENVIRONMENT VARIABLES (Express / Node.js)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5001

# JWT Secret for session authentication (Generate a 64+ character random string)
JWT_SECRET=your_super_secret_jwt_key_here_change_for_production

# CORS Allowed Origins
# Specify your production frontend URL (e.g., https://shoes-store.vercel.app)
# Multiple origins can be comma-separated.
CLIENT_URL=https://your-domain.vercel.app

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (MySQL)
# ------------------------------------------------------------------------------
# NOTE: Vercel serverless functions CANNOT reach your local XAMPP MySQL database (127.0.0.1).
# For Vercel production deployment, use a free cloud-hosted MySQL database
# (such as PlanetScale, TiDB Cloud, Aiven, Railway, or AWS RDS).

# Option A: Full Cloud Database URI (Recommended for cloud providers)
DATABASE_URL=mysql://username:password@your-cloud-db-host.com:3306/jod_shoes_store

# Option B: Individual Connection Parameters
DB_HOST=your-cloud-db-host.com
DB_PORT=3306
DB_NAME=jod_shoes_store
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_SSL=true

